{
  "name": "@amber-protocol/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/dev-bootstrap.mts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && npm run test:e2e:semantic",
    "test:e2e:semantic": "node -e \"process.env.AMBER_E2E_SEMANTIC_STUB='1';const{spawnSync}=require('node:child_process');const cli=require.resolve('@playwright/test/cli');const r=spawnSync(process.execPath,[cli,'test','tests/e2e/knowledge.spec.ts','--grep','user-triggered semantic stub'],{stdio:'inherit',env:process.env});process.exit(r.status??1)\"",
    "format": "prettier --write src server tests index.html eslint.config.mjs playwright.config.ts vitest.config.ts vite.config.mts postcss.config.js tailwind.config.js tsconfig*.json package.json",
    "format:check": "prettier --check src server tests index.html eslint.config.mjs playwright.config.ts vitest.config.ts vite.config.mts postcss.config.js tailwind.config.js tsconfig*.json package.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xyflow/react": "^12.11.5",
    "d3-force": "^3.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "superjson": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "express": "^5.2.1",
    "globals": "^6.1.0",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "zod-validation-error": "^4.0.2"
  }
}
