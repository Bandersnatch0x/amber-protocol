{
  "name": "@amber-protocol/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/dev-bootstrap.mts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests index.html eslint.config.mjs playwright.config.ts vitest.config.ts vite.config.mts postcss.config.js tailwind.config.js tsconfig*.json package.json",
    "format:check": "prettier --check src server tests index.html eslint.config.mjs playwright.config.ts vitest.config.ts vite.config.mts postcss.config.js tailwind.config.js tsconfig*.json package.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "highlight.js": "^11.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "superjson": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "express": "^5.2.1",
    "globals": "^6.1.0",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^1.4.0"
  },
  "overrides": {
    "zod-validation-error": "^4.0.2"
  }
}
