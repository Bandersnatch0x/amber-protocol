# === Amber Web Viewer — Environment Variables ===
# Copy this file to .env and adjust as needed.

# Server port (default: 3001)
PORT=3001

# Bind address (default: 127.0.0.1 — loopback only for security)
# Set to 0.0.0.0 to expose on all interfaces (LAN access).
HOST=127.0.0.1

# SSE authentication secret.
# Must be set in production. When unset in development, the SSE endpoint
# is open (no auth required). In production, unset = all SSE connections
# receive 401.
SSE_AUTH_SECRET=

# Node environment: 'development' | 'production'
NODE_ENV=development

# === External Error Monitoring (Phase D) ===
# Read server-side only. The browser POSTs errors to /api/errors and the server
# forwards them here, so these URLs never ship in the client bundle.

# Sentry DSN for error reporting (optional — no SDK required)
# SENTRY_DSN=https://o0.ingest.sentry.io/0

# Generic error webhook URL (optional — POSTed with the error payload)
# ERROR_WEBHOOK_URL=https://your-monitoring.example.com/errors
