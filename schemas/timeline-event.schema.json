{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["timestamp", "type"],
	"properties": {
		"timestamp": { "type": "string", "format": "date-time" },
		"type": {
			"enum": [
				"session_created",
				"route_selected",
				"stage_started",
				"stage_completed",
				"stage_failed",
				"run_started",
				"run_completed",
				"run_failed",
				"policy_denied",
				"approval_requested",
				"approval_granted",
				"approval_consumed",
				"session_blocked",
				"session_unblocked",
				"context_granted",
				"context_denied",
				"verification_failed",
				"gate_triggered",
				"gate_passed",
				"gate_failed",
				"checkpoint_created",
				"session_paused",
				"session_resumed",
				"session_completed",
				"session_failed",
				"session_aborted",
				"budget_warning",
				"budget_exceeded",
				"error"
			]
		},
		"stage": { "type": "string" },
		"data": { "type": "object" },
		"runId": { "description": "Lossless derived run id (run contract R-ID-1) on run/projected events.", "type": "string" },
		"actor": { "description": "Acting principal id on actor-attributed events.", "type": "string" },
		"sequence": { "description": "Chained run-events sequence number; appended gradually, absent on legacy events.", "type": "integer", "minimum": 1 },
		"prevHash": { "description": "Chained run-events previous hash; absent on legacy plaintext events.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"hash": { "description": "Chained run-events body hash; absent on legacy plaintext events.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"error": {
			"type": "object",
			"properties": {
				"message": { "type": "string" },
				"stack": { "type": "string" },
				"recoverable": { "type": "boolean" }
			}
		},
		"amber_protocol_version": { "type": "string" },
		"artifact_sequence": { "type": "integer" },
		"created_at": { "type": "string", "format": "date-time" },
		"artifact_type": { "type": "string" }
	}
}
