+      const totalPages = Math.ceil(total / pageSize);
+      const offset = (page - 1) * pageSize;
+      const paginatedSessions = sorted.slice(offset, offset + pageSize);
+
+      return {
+        sessions: paginatedSessions,
+        pagination: {
