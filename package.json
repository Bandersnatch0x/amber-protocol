{
  "name": "coding-harness",
  "version": "1.0.0",
  "description": "Safe Harness Bootstrap toolkit for repository-local agent instructions, wiki, validation, and handoff.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "coding-harness": "scripts/harness.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --test",
    "doctor": "node scripts/harness.js doctor --target .",
    "handoff": "node scripts/harness.js handoff --target .",
    "manifests": "node scripts/validate-manifests.js --target .",
    "test:load": "node --test tests/load/"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemailer": "^8.0.11"
  }
}
