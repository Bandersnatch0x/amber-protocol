{
	"actionTypeId": "amber.context.load",
	"version": 1,
	"title": "Assemble context loadout",
	"goal": "Build a deterministic, freshness-gated, budgeted Context Loadout for a route and write it to disk.",
	"mode": "interactive",
	"parameters": {
		"route": {
			"type": "string",
			"required": true,
			"description": "Route id whose Required Artifacts and Context Pages seed the loadout."
		},
		"feature": {
			"type": "string",
			"required": false,
			"description": "Optional feature id scoping the loadout selection."
		}
	},
	"submissionCriteria": ["route exists"],
	"effects": {
		"edits": [".amber/context/loadouts/", ".amber/context/events.jsonl"],
		"sideEffects": ["ledger-append"],
		"rollback": true
	},
	"evidenceRequired": ["ingest-record"],
	"timeout": 180,
	"governance": {
		"policy": "governance/policy.md#context-load",
		"approver": ["human"],
		"evidence": ["ingest-record"],
		"circuitBreaker": true,
		"worktreeIsolation": false
	},
	"execution": {
		"command": "context",
		"subcommand": "load",
		"args": [
			{ "flag": "--route", "source": "parameters.route" },
			{ "flag": "--feature", "source": "parameters.feature", "optional": true }
		]
	}
}
